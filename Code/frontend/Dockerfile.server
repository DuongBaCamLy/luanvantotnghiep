FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
# The faculty server has a slow, flaky link to the npm registry, so keep
# the package cache between builds and retry patiently.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --fetch-timeout=900000 --fetch-retries=5 \
      --fetch-retry-maxtimeout=180000 --maxsockets=4

COPY . .
# ImportSyllabusDialog imports ../../../../templates/*.xlsx, which resolves to /templates
COPY --from=templates . /templates

ARG VITE_API_BASE_URL=/
ARG VITE_GOOGLE_CLIENT_ID=

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN npm run build


FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx","-g","daemon off;"]