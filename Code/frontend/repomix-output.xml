import { useQuery } from "@tanstack/react-query"
import { Users, Building2, GraduationCap, BookOpen, FileText, Clock, Shield } from "lucide-react"

import { getUsers } from "@/api/userApi"
import { departmentApi } from "@/api/departmentApi"
import { programApi } from "@/api/programApi"
import { courseApi } from "@/api/courseApi"
import { syllabusApi } from "@/api/syllabusApi"
import { auditLogApi } from "@/api/auditLogApi"

import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card"
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table"
import { Badge } from "@/components/ui/badge"

export default function AdminDashboardPage() {
  // Query sizes for cards
  const { data: users } = useQuery({ queryKey: ["users"], queryFn: getUsers })
  const { data: departments } = useQuery({ queryKey: ["departments"], queryFn: departmentApi.getAll })
  const { data: programs } = useQuery({ queryKey: ["programs"], queryFn: programApi.getAll })
  const { data: courses } = useQuery({ queryKey: ["courses"], queryFn: courseApi.getAll })
  const { data: syllabuses } = useQuery({ queryKey: ["syllabuses"], queryFn: syllabusApi.getAll })
  const { data: auditLogs, isLoading: isLoadingLogs } = useQuery({ queryKey: ["audit-logs"], queryFn: auditLogApi.getAll })

  // Calculate account counts per role
  const roleCounts = {
    ADMIN: 0,
    DEAN: 0,
    PROGRAM_COORDINATOR: 0,
    DEPT_HEAD: 0,
    INSTRUCTOR: 0,
    STUDENT: 0,
  }

  if (users) {
    users.forEach((u) => {
      if (u.role in roleCounts) {
        roleCounts[u.role as keyof typeof roleCounts]++
      }
    })
  }

  const stats = [
    { label: "Người dùng", value: users?.length ?? 0, icon: Users, color: "text-blue-600 bg-blue-50" },
    { label: "Khoa / Bộ môn", value: departments?.length ?? 0, icon: Building2, color: "text-emerald-600 bg-emerald-50" },
    { label: "Chương trình", value: programs?.length ?? 0, icon: GraduationCap, color: "text-indigo-600 bg-indigo-50" },
    { label: "Môn học", value: courses?.length ?? 0, icon: BookOpen, color: "text-amber-600 bg-amber-50" },
    { label: "Syllabus đề cương", value: syllabuses?.length ?? 0, icon: FileText, color: "text-rose-600 bg-rose-50" },
  ]

  const getActionBadge = (action: string) => {
    switch (action.toUpperCase()) {
      case "CREATE":
        return <Badge className="bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-50">TẠO MỚI</Badge>
      case "UPDATE":
        return <Badge className="bg-amber-50 text-amber-700 border-amber-200 hover:bg-amber-50">CẬP NHẬT</Badge>
      case "DELETE":
        return <Badge className="bg-rose-50 text-rose-700 border-rose-200 hover:bg-rose-50">XÓA</Badge>
      default:
        return <Badge className="bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-50">{action}</Badge>
    }
  }

  return (
    <div className="space-y-6">
      {/* Page Header */}
      <div>
        <h1 className="text-2xl font-bold text-primary font-heading">
          Tổng quan hệ thống
        </h1>
        <p className="text-sm text-slate-500">
          Chào mừng bạn đến với Bảng điều khiển quản trị của SCSE Curriculum Management.
        </p>
      </div>

      {/* Grid Stats */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {stats.map((s) => {
          const Icon = s.icon
          return (
            <Card key={s.label} className="border border-slate-100 shadow-sm bg-white">
              <CardContent className="p-5 flex items-center justify-between">
                <div className="space-y-1">
                  <p className="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                    {s.label}
                  </p>
                  <p className="text-2xl font-bold text-slate-900 font-heading">
                    {s.value}
                  </p>
                </div>
                <div className={`p-2.5 rounded-lg ${s.color}`}>
                  <Icon className="size-5" />
                </div>
              </CardContent>
            </Card>
          )
        })}
      </div>

      {/* Main Sections */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* Left Side: Recent Activity Logs */}
        <Card className="lg:col-span-2 border border-slate-100 shadow-sm bg-white">
          <CardHeader className="border-b border-slate-100 pb-3 flex flex-row items-center justify-between">
            <div>
              <CardTitle className="text-base font-bold text-slate-800 font-heading flex items-center gap-2">
                <Clock className="size-4.5 text-slate-400" />
                Nhật ký hoạt động gần đây
              </CardTitle>
              <CardDescription>Các thay đổi mới nhất trong cơ sở dữ liệu hệ thống</CardDescription>
            </div>
          </CardHeader>
          <CardContent className="p-0">
            <Table>
              <TableHeader>
                <TableRow className="bg-slate-50/50">
                  <TableHead className="font-semibold text-xs uppercase w-[150px]">Thời gian</TableHead>
                  <TableHead className="font-semibold text-xs uppercase w-[100px]">Hành động</TableHead>
                  <TableHead className="font-semibold text-xs uppercase w-[150px]">Bảng dữ liệu</TableHead>
                  <TableHead className="font-semibold text-xs uppercase w-[80px]">Mã ID</TableHead>
                  <TableHead className="font-semibold text-xs uppercase text-right">Người thực hiện</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {isLoadingLogs ? (
                  <TableRow>
                    <TableCell colSpan={5} className="text-center py-6 text-slate-400">
                      Đang tải nhật ký...
                    </TableCell>
                  </TableRow>
                ) : !auditLogs || auditLogs.length === 0 ? (
                  <TableRow>
                    <TableCell colSpan={5} className="text-center py-6 text-slate-400">
                      Không có hoạt động nào được ghi lại.
                    </TableCell>
                  </TableRow>
                ) : (
                  auditLogs.slice(0, 5).map((log) => (
                    <TableRow key={log.id} className="hover:bg-slate-50/30">
                      <TableCell className="text-xs text-slate-500">
                        {new Date(log.changedAt).toLocaleString("vi-VN")}
                      </TableCell>
                      <TableCell>{getActionBadge(log.action)}</TableCell>
                      <TableCell className="font-mono text-xs text-slate-600 font-medium">
                        {log.tableName}
                      </TableCell>
                      <TableCell className="text-slate-500 text-xs">#{log.recordId}</TableCell>
                      <TableCell className="text-right text-sm font-medium text-slate-700">
                        ID: {log.changedById}
                      </TableCell>
                    </TableRow>
                  ))
                )}
              </TableBody>
            </Table>
          </CardContent>
        </Card>

        {/* Right Side: Account Distribution by Role */}
        <Card className="border border-slate-100 shadow-sm bg-white">
          <CardHeader className="border-b border-slate-100 pb-3">
            <CardTitle className="text-base font-bold text-slate-800 font-heading flex items-center gap-2">
              <Shield className="size-4.5 text-slate-400" />
              Tài khoản theo vai trò
            </CardTitle>
            <CardDescription>Số lượng người dùng theo chức vụ</CardDescription>
          </CardHeader>
          <CardContent className="pt-4 flex flex-col gap-4">
            {[
              { label: "Quản trị viên (ADMIN)", count: roleCounts.ADMIN, color: "bg-blue-500" },
              { label: "Trưởng khoa (DEAN)", count: roleCounts.DEAN, color: "bg-purple-500" },
              { label: "Trưởng bộ môn (DEPT_HEAD)", count: roleCounts.DEPT_HEAD, color: "bg-emerald-500" },
              { label: "Điều phối (COORDINATOR)", count: roleCounts.PROGRAM_COORDINATOR, color: "bg-cyan-500" },
              { label: "Giảng viên (INSTRUCTOR)", count: roleCounts.INSTRUCTOR, color: "bg-amber-500" },
              { label: "Sinh viên (STUDENT)", count: roleCounts.STUDENT, color: "bg-slate-400" },
            ].map((role) => (
              <div key={role.label} className="flex flex-col gap-1.5">
                <div className="flex items-center justify-between text-xs font-semibold text-slate-600">
                  <span>{role.label}</span>
                  <span>{role.count}</span>
                </div>
                <div className="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                  <div
                    className={`${role.color} h-full transition-all duration-500`}
                    style={{
                      width: users && users.length > 0 ? `${(role.count / users.length) * 100}%` : "0%",
                    }}
                  />
                </div>
              </div>
            ))}
          </CardContent>
        </Card>
      </div>
    </div>
  )
}
</file>

