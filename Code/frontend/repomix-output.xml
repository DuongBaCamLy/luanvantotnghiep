                </Button>
                <Button
                  size="sm"
                  variant="outline"
                  onClick={() => { setShowForm(false); setErrors({}) }}
                  className="h-8 text-xs"
                >
                  Hủy
                </Button>
              </div>
            </div>
          )}
        </CardContent>
      </Card>

      {/* Summary */}
