<file path="src/components/syllabus/SyllabusForm.tsx">
import { useState, useMemo, useEffect } from "react"
import { Input } from "@/components/ui/input"
import { Label } from "@/components/ui/label"
import { Button } from "@/components/ui/button"
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select"
import { BookOpen, Copy, FileText, AlertCircle } from "lucide-react"

import type { CreateSyllabusRequest } from "@/types/syllabus"
import { useAuthStore } from "@/store/authStore"
import { useCourses } from "@/hooks/useCourses"
import { useSyllabuses } from "@/hooks/useSyllabuses"

interface Props {
  initialData?: CreateSyllabusRequest
  onSubmit: (values: CreateSyllabusRequest) => void
  loading?: boolean
  submitLabel?: string
}

export default function SyllabusForm({
  initialData,
  onSubmit,
  loading,
  submitLabel = "Lưu đề cương",
}: Props) {
  const user = useAuthStore((state) => state.user)
  const { data: courses, isLoading: isLoadingCourses } = useCourses()
  const { data: syllabuses } = useSyllabuses()

  const [form, setForm] = useState<CreateSyllabusRequest>(
    initialData ?? {
      courseId: 0,
      versionNumber: 1,
      versionLabel: "",
      academicYear: "",
      createdBy: user?.userId ?? 0,
      changeSummary: "",
      notes: "",
      sourceSyllabusId: undefined,
    }
  )

  const [selectedCourseId, setSelectedCourseId] = useState<string>(
    initialData?.courseId ? String(initialData.courseId) : ""
  )
  
  const [selectedSourceId, setSelectedSourceId] = useState<string>(
    initialData?.sourceSyllabusId ? String(initialData.sourceSyllabusId) : "none"
  )

  // Filter existing syllabi for the selected course to enable cloning options
  const existingSyllabuses = useMemo(() => {
    if (!selectedCourseId || !syllabuses) return []
    return syllabuses.filter((s) => s.courseId === Number(selectedCourseId))
  }, [selectedCourseId, syllabuses])

  // Automatically update course details, suggest version label & number when course changes
  useEffect(() => {
    if (selectedCourseId) {
      const courseIdNum = Number(selectedCourseId)
      const maxVer = existingSyllabuses.length > 0
        ? Math.max(...existingSyllabuses.map((s) => s.versionNumber))
        : 0
      const nextVerNum = maxVer + 1
      
      setForm((prev) => ({
        ...prev,
        courseId: courseIdNum,
        versionNumber: nextVerNum,
        // Only override if label is empty or matches auto-format from before
        versionLabel: prev.versionLabel && !prev.versionLabel.startsWith("v") 
          ? prev.versionLabel 
          : `v${nextVerNum}.0`,
      }))
    } else {
      setForm((prev) => ({
        ...prev,
        courseId: 0,
        versionNumber: 1,
        versionLabel: "",
      }))
    }
    // Reset clone selection when course changes
    setSelectedSourceId("none")
  }, [selectedCourseId, existingSyllabuses])

  // Apply source syllabus clone choice
  useEffect(() => {
    setForm((prev) => ({
      ...prev,
      sourceSyllabusId: selectedSourceId === "none" ? undefined : Number(selectedSourceId),
    }))
  }, [selectedSourceId])

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault()

    if (!form.courseId) {
      alert("Vui lòng chọn môn học")
      return
    }

    if (!form.academicYear) {
      alert("Vui lòng chọn năm học áp dụng")
      return
    }

    onSubmit({
      ...form,
      createdBy: user?.userId ?? 0,
    })
  }

  // Academic year options
  const ACADEMIC_YEARS = ["2023-2024", "2024-2025", "2025-2026", "2026-2027"]

  if (isLoadingCourses) {
    return (
      <div className="flex justify-center items-center h-48">
        <div className="text-slate-500 animate-pulse flex items-center gap-2">
          <BookOpen className="animate-spin size-5 text-primary" />
          Đang tải danh sách môn học...
        </div>
      </div>
    )
  }

  return (
    <form onSubmit={handleSubmit} className="flex flex-col gap-6 max-w-3xl mx-auto">
      {/* 1. Môn học & Clone Source */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-5 bg-slate-50/50 dark:bg-slate-800/20 p-5 rounded-xl border border-slate-100 dark:border-slate-800 shadow-sm">
        {/* Course Select */}
        <div className="flex flex-col gap-2">
          <Label className="text-sm font-semibold text-slate-700 dark:text-slate-300">
            Môn học áp dụng <span className="text-rose-500">*</span>
          </Label>
          <Select value={selectedCourseId} onValueChange={setSelectedCourseId}>
            <SelectTrigger className="h-10 w-full bg-white dark:bg-slate-900 border-slate-200">
              <SelectValue placeholder="Chọn môn học..." />
            </SelectTrigger>
            <SelectContent>
              {courses?.map((c) => (
                <SelectItem key={c.id} value={String(c.id)}>
                  {c.courseCode} - {c.nameVn || c.name}
                </SelectItem>
              ))}
            </SelectContent>
          </Select>
        </div>

        {/* Clone Dropdown (Shown only if course has previous syllabi) */}
        <div className="flex flex-col gap-2">
          <Label className="text-sm font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <Copy className="size-4 text-slate-400" />
            Sao chép từ đề cương cũ (Tùy chọn)
          </Label>
          <Select
            value={selectedSourceId}
            onValueChange={setSelectedSourceId}
            disabled={!selectedCourseId || existingSyllabuses.length === 0}
          >
            <SelectTrigger className="h-10 w-full bg-white dark:bg-slate-900 border-slate-200">
              <SelectValue placeholder={
                !selectedCourseId 
                  ? "Chọn môn học trước..." 
                  : existingSyllabuses.length === 0 
                    ? "Chưa có đề cương cũ nào" 
                    : "Chọn đề cương cũ để sao chép..."
              } />
            </SelectTrigger>
            <SelectContent>
              <SelectItem value="none">Tạo mới hoàn toàn (Không sao chép)</SelectItem>
              {existingSyllabuses.map((s) => (
                <SelectItem key={s.id} value={String(s.id)}>
                  {s.versionLabel} (Năm học {s.academicYear}) - {s.status === "APPROVED" ? "Đã duyệt" : "Bản nháp/Khác"}
                </SelectItem>
              ))}
            </SelectContent>
          </Select>
        </div>
      </div>

      {/* Info Warning if Cloning */}
      {selectedSourceId !== "none" && (
        <div className="flex items-start gap-2.5 p-3.5 bg-sky-50 dark:bg-sky-950/20 border border-sky-100 dark:border-sky-900 rounded-lg text-sky-800 dark:text-sky-300 text-sm">
          <AlertCircle className="size-5 shrink-0 text-sky-500 mt-0.5" />
          <div>
            <strong>Chế độ sao chép đề cương:</strong> Hệ thống sẽ tự động nhân bản toàn bộ thông tin chuẩn đầu ra (CLO), ma trận mapping CLO-PLO, tuần học và đề mục đánh giá từ đề cương cũ được chọn sang bản nháp mới này.
          </div>
        </div>
      )}

      {/* 2. Metadata: Version, Year */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div className="flex flex-col gap-2">
          <Label className="text-sm font-semibold text-slate-700 dark:text-slate-300">
            Năm học áp dụng <span className="text-rose-500">*</span>
          </Label>
          <Select
            value={form.academicYear}
            onValueChange={(val) => setForm({ ...form, academicYear: val })}
          >
            <SelectTrigger className="h-10 w-full bg-white dark:bg-slate-900 border-slate-200">
              <SelectValue placeholder="Chọn năm học..." />
            </SelectTrigger>
            <SelectContent>
              {ACADEMIC_YEARS.map((y) => (
                <SelectItem key={y} value={y}>
                  Năm học {y}
                </SelectItem>
              ))}
            </SelectContent>
          </Select>
        </div>

        <div className="flex flex-col gap-2">
          <Label className="text-sm font-semibold text-slate-700 dark:text-slate-300">
            Số phiên bản (Version Number)
          </Label>
          <Input
            type="number"
            min={1}
            value={form.versionNumber}
            onChange={(e) =>
              setForm({
                ...form,
                versionNumber: Number(e.target.value),
              })
            }
            className="h-10 bg-white dark:bg-slate-900 border-slate-200"
          />
        </div>

        <div className="flex flex-col gap-2">
          <Label className="text-sm font-semibold text-slate-700 dark:text-slate-300">
            Nhãn phiên bản (Version Label)
          </Label>
          <Input
            placeholder="VD: v1.0, v2024.1..."
            value={form.versionLabel}
            onChange={(e) =>
              setForm({
                ...form,
                versionLabel: e.target.value,
              })
            }
            className="h-10 bg-white dark:bg-slate-900 border-slate-200"
          />
        </div>
      </div>

      {/* 3. Textareas: Change Summary & Notes */}
      <div className="flex flex-col gap-5">
        <div className="flex flex-col gap-2">
          <Label className="text-sm font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <FileText className="size-4 text-slate-400" />
            Tóm tắt thay đổi (Change Summary)
          </Label>
          <textarea
            placeholder="Nhập tóm tắt các điểm cập nhật so với phiên bản cũ (nếu có)..."
            value={form.changeSummary || ""}
            onChange={(e) => setForm({ ...form, changeSummary: e.target.value })}
            className="flex min-h-[90px] w-full rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3 py-2 text-sm transition-colors placeholder:text-slate-400 outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50"
          />
        </div>

        <div className="flex flex-col gap-2">
          <Label className="text-sm font-semibold text-slate-700 dark:text-slate-300">
            Ghi chú nội bộ (Notes)
          </Label>
          <textarea
            placeholder="Nhập các ghi chú thêm cho trưởng bộ môn hoặc khoa..."
            value={form.notes || ""}
            onChange={(e) => setForm({ ...form, notes: e.target.value })}
            className="flex min-h-[90px] w-full rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3 py-2 text-sm transition-colors placeholder:text-slate-400 outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50"
          />
        </div>
      </div>

      {/* 4. Action Buttons */}
      <div className="flex justify-end gap-3 border-t border-slate-100 dark:border-slate-800 pt-5 mt-2">
        <Button
          type="submit"
          disabled={loading || !selectedCourseId}
          className="bg-primary text-white hover:bg-primary/90 px-6 h-10 shadow-sm"
        >
          {loading ? "Đang xử lý..." : submitLabel}
        </Button>
      </div>
    </form>
  )
}
