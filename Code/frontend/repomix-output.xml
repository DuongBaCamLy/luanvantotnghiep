import type { CreateSyllabusRequest } from "@/types/syllabus";

export default function SyllabusEditPage() {
  const { id } = useParams();

  const navigate = useNavigate();

  const syllabusId =
    Number(id);

  const {
    data,
    isLoading,
  } = useSyllabus(
    syllabusId
  );

  const updateMutation =
    useUpdateSyllabus();

  if (isLoading) {
    return <div>Loading...</div>;
  }

  if (!data) {
    return (
      <div>
        Syllabus not found
      </div>
    );
  }

  const initialData: CreateSyllabusRequest =
    {
      courseId:
        data.courseId,

      versionNumber:
        data.versionNumber,

      versionLabel:
        data.versionLabel,

      academicYear:
        data.academicYear,

      createdBy:
        data.createdById,

      changeSummary:
  data.changeSummary ?? "",

    notes:
  data.notes ?? "",
    };

  const handleUpdate = (
    values: CreateSyllabusRequest
  ) => {
    updateMutation.mutate(
      {
        id: syllabusId,
        data: values,
      },
      {
        onSuccess: () => {
          navigate(
            "/dept-head/syllabus"
