import { useState, useMemo } from "react";
import { Link } from "react-router-dom";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Search, Filter, RotateCcw, Plus } from "lucide-react";

import SyllabusTable from "@/components/syllabus/SyllabusTable";
import { useSyllabuses } from "@/hooks/useSyllabuses";
import { getSyllabusMetadata, MAJORS, SPECIALIZATIONS } from "@/lib/syllabusHelper";

export default function SyllabusListPage() {
  const { data, isLoading, isError } = useSyllabuses();

  // Temporary selected filter states (controlled inputs)
  const [searchVal, setSearchVal] = useState("");
  const [majorVal, setMajorVal] = useState("all");
  const [specVal, setSpecVal] = useState("all");
  const [yearVal, setYearVal] = useState("all");
  const [statusVal, setStatusVal] = useState("all");
  const [verVal, setVerVal] = useState("all");

  // Active filter states applied to the actual list
  const [activeFilters, setActiveFilters] = useState({
    search: "",
    major: "all",
    specialization: "all",
    academicYear: "all",
    status: "all",
    version: "all",
  });

  // Extract unique academic years and versions from dataset to populate filters dynamically
  const uniqueYears = useMemo(() => {
    if (!data) return [];
    return Array.from(new Set(data.map((item) => item.academicYear).filter(Boolean))).sort();
  }, [data]);

  const uniqueVersions = useMemo(() => {
    if (!data) return [];
    return Array.from(new Set(data.map((item) => item.versionLabel).filter(Boolean))).sort();
  }, [data]);

  // Apply filters
  const handleApplyFilters = () => {
    setActiveFilters({
      search: searchVal,
      major: majorVal,
      specialization: specVal,
      academicYear: yearVal,
      status: statusVal,
      version: verVal,
    });
  };

  // Reset filters
  const handleResetFilters = () => {
    setSearchVal("");
    setMajorVal("all");
    setSpecVal("all");
    setYearVal("all");
    setStatusVal("all");
    setVerVal("all");
    setActiveFilters({
      search: "",
      major: "all",
      specialization: "all",
      academicYear: "all",
      status: "all",
      version: "all",
    });
  };

  // Process the syllabus data with active filters
  const filteredData = useMemo(() => {
    if (!data) return [];
    return data.filter((item) => {
      const metadata = getSyllabusMetadata(item.courseCode, item.courseName);

      // Search query filter (matches code or name)
      if (activeFilters.search) {
        const query = activeFilters.search.toLowerCase().trim();
        const codeMatch = (item.courseCode || "").toLowerCase().includes(query);
        const nameMatch = (item.courseName || "").toLowerCase().includes(query);
        if (!codeMatch && !nameMatch) return false;
      }

      // Major filter
      if (activeFilters.major !== "all") {
        if (metadata.major !== activeFilters.major) return false;
      }

      // Specialization filter
      if (activeFilters.specialization !== "all") {
        if (metadata.specialization !== activeFilters.specialization) return false;
      }

      // Academic year filter
      if (activeFilters.academicYear !== "all") {
        if (item.academicYear !== activeFilters.academicYear) return false;
      }

      // Status filter
      if (activeFilters.status !== "all") {
        if (item.status !== activeFilters.status) return false;
      }

      // Version filter
      if (activeFilters.version !== "all") {
        if (item.versionLabel !== activeFilters.version) return false;
      }

      return true;
    });
  }, [data, activeFilters]);

  if (isLoading) {
    return (
      <div className="flex h-64 items-center justify-center">
        <div className="text-lg font-medium text-muted-foreground animate-pulse">
          Đang tải danh sách đề cương...
        </div>
      </div>
    );
  }

  if (isError) {
    return (
      <div className="rounded-xl border border-destructive/20 bg-destructive/5 p-6 text-center text-destructive">
        <h3 className="font-bold text-lg mb-2">Đã xảy ra lỗi</h3>
        <p>Không thể tải dữ liệu đề cương môn học. Vui lòng thử lại sau.</p>
      </div>
    );
  }

  return (
    <Card className="shadow-md border border-slate-100 bg-white dark:bg-slate-900/50">
      <CardHeader className="flex flex-row items-center justify-between border-b border-slate-100 pb-4">
        <div>
          <CardTitle className="text-2xl font-bold text-primary font-heading">
            Quản lý đề cương
          </CardTitle>
          <CardDescription className="text-slate-500">
            Danh sách đề cương môn học của khoa SCSE
          </CardDescription>
        </div>
        <Link to="/dept-head/syllabus/create">
          <Button className="bg-primary text-white hover:bg-primary/90 flex items-center gap-1.5 shadow-sm text-sm py-2">
            <Plus className="size-4" />
            Tạo đề cương mới
          </Button>
        </Link>
      </CardHeader>

      <CardContent className="pt-6 flex flex-col gap-6">
        {/* Filter Panel */}
        <div className="bg-slate-50/50 dark:bg-slate-800/40 p-4 rounded-xl border border-slate-100 dark:border-slate-800 flex flex-col gap-4">
          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
            {/* Search Input */}
            <div className="md:col-span-2 flex flex-col gap-1.5">
              <Label htmlFor="search-input" className="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                Tìm kiếm môn học
              </Label>
              <div className="relative">
                <Search className="absolute left-2.5 top-2.5 size-4 text-slate-400" />
                <Input
                  id="search-input"
                  placeholder="Mã môn hoặc tên môn học..."
                  className="pl-9 h-9"
                  value={searchVal}
                  onChange={(e) => setSearchVal(e.target.value)}
                />
              </div>
            </div>

            {/* Major Select */}
            <div className="flex flex-col gap-1.5">
              <Label className="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                Ngành học
              </Label>
              <Select value={majorVal} onValueChange={setMajorVal}>
                <SelectTrigger className="h-9 w-full justify-between">
                  <SelectValue placeholder="Tất cả các ngành" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">Tất cả các ngành</SelectItem>
                  {MAJORS.map((m) => (
                    <SelectItem key={m} value={m}>
                      {m}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            {/* Specialization Select */}
            <div className="flex flex-col gap-1.5">
              <Label className="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                Chuyên ngành
              </Label>
              <Select value={specVal} onValueChange={setSpecVal}>
                <SelectTrigger className="h-9 w-full justify-between">
                  <SelectValue placeholder="Tất cả chuyên ngành" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">Tất cả chuyên ngành</SelectItem>
                  {SPECIALIZATIONS.map((s) => (
                    <SelectItem key={s} value={s}>
                      {s}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
            {/* Academic Year Select */}
            <div className="flex flex-col gap-1.5">
              <Label className="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                Năm học
              </Label>
              <Select value={yearVal} onValueChange={setYearVal}>
                <SelectTrigger className="h-9 w-full justify-between">
                  <SelectValue placeholder="Tất cả năm học" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">Tất cả năm học</SelectItem>
                  {uniqueYears.map((y) => (
                    <SelectItem key={y} value={y}>
                      Năm học {y}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            {/* Version Select */}
            <div className="flex flex-col gap-1.5">
              <Label className="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                Phiên bản
              </Label>
              <Select value={verVal} onValueChange={setVerVal}>
                <SelectTrigger className="h-9 w-full justify-between">
                  <SelectValue placeholder="Tất cả phiên bản" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">Tất cả phiên bản</SelectItem>
                  {uniqueVersions.map((v) => (
                    <SelectItem key={v} value={v}>
                      {v}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            {/* Status Select */}
            <div className="flex flex-col gap-1.5">
              <Label className="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                Trạng thái
              </Label>
              <Select value={statusVal} onValueChange={setStatusVal}>
                <SelectTrigger className="h-9 w-full justify-between">
                  <SelectValue placeholder="Tất cả trạng thái" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">Tất cả trạng thái</SelectItem>
                  <SelectItem value="DRAFT">Bản nháp</SelectItem>
                  <SelectItem value="SUBMITTED">Đã nộp</SelectItem>
                  <SelectItem value="APPROVED">Đã duyệt</SelectItem>
                  <SelectItem value="REJECTED">Từ chối</SelectItem>
                </SelectContent>
              </Select>
            </div>

            {/* Actions Buttons */}
            <div className="flex gap-2">
              <Button
                onClick={handleApplyFilters}
                className="flex-1 h-9 bg-primary text-white hover:bg-primary/95 flex items-center justify-center gap-1.5 text-sm"
              >
                <Filter className="size-4" />
                Lọc
              </Button>
              <Button
                variant="outline"
                onClick={handleResetFilters}
                className="h-9 flex items-center justify-center gap-1.5 text-sm"
              >
                <RotateCcw className="size-4" />
                Xóa bộ lọc
              </Button>
            </div>
          </div>
        </div>

        {/* Results Info */}
        <div className="text-sm text-slate-500 flex justify-between items-center px-1">
          <span>
            Tìm thấy <strong>{filteredData.length}</strong> kết quả
          </span>
        </div>

        {/* Syllabus Table */}
        <div className="rounded-xl border border-slate-100 overflow-hidden bg-white shadow-sm dark:bg-slate-900/40 dark:border-slate-800">
          <SyllabusTable data={filteredData} />
        </div>
      </CardContent>
    </Card>
  );
}
