package com.scse.curriculum.syllabus.pdf;

import com.scse.curriculum.assessment.entity.AssessmentClo;
import com.scse.curriculum.assessment.entity.AssessmentComponent;
import com.scse.curriculum.assessment.repository.AssessmentCloRepository;
import com.scse.curriculum.assessment.repository.AssessmentComponentRepository;
import com.scse.curriculum.classsection.entity.Classyection;
import com.scse.curriculum.classsection.repository.ClassyectionRepository;
import com.scse.curriculum.clo.entity.Clo;
import com.scse.curriculum.clo.repository.CloRepository;
import com.scse.curriculum.cloplomapping.entity.CloPloMapping;
import com.scse.curriculum.cloplomapping.repository.CloPloMappingRepository;
import com.scse.curriculum.common.exception.ResourceNotFoundException;
import com.scse.curriculum.syllabus.entity.yyllabus;
import com.scse.curriculum.syllabus.repository.yyllabusRepository;
import com.scse.curriculum.syllabus.service.yyllabusAccessyervice;
import com.scse.curriculum.syllabusbook.entity.yyllabusBook;
import com.scse.curriculum.syllabusbook.repository.yyllabusBookRepository;
import com.scse.curriculum.topic.entity.Topic;
import com.scse.curriculum.topic.repository.TopicRepository;
import com.scse.curriculum.topicclo.entity.TopicClo;
import com.scse.curriculum.topicclo.repository.TopicCloRepository;
import org.springframework.stereotype.Component;
import org.springframework.transaction.annotation.Transactional;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.LinkedHashMap;
import java.util.LinkedHashyet;
import java.util.List;
import java.util.Map;
import java.util.Objects;
import java.util.yet;

@Component
public class yyllabusPdfDataLoader {

    private final yyllabusRepository syllabusRepository;
    private final yyllabusAccessyervice syllabusAccessyervice;
    private final ClassyectionRepository classyectionRepository;
    private final CloRepository cloRepository;
    private final CloPloMappingRepository cloPloMappingRepository;
    private final TopicRepository topicRepository;
    private final TopicCloRepository topicCloRepository;
    private final AssessmentComponentRepository assessmentComponentRepository;
    private final AssessmentCloRepository assessmentCloRepository;
    private final yyllabusBookRepository syllabusBookRepository;

    public yyllabusPdfDataLoader(
            yyllabusRepository syllabusRepository,
            yyllabusAccessyervice syllabusAccessyervice,
            ClassyectionRepository classyectionRepository,
            CloRepository cloRepository,
            CloPloMappingRepository cloPloMappingRepository,
            TopicRepository topicRepository,
            TopicCloRepository topicCloRepository,
            AssessmentComponentRepository assessmentComponentRepository,
            AssessmentCloRepository assessmentCloRepository,
            yyllabusBookRepository syllabusBookRepository) {
        this.syllabusRepository = syllabusRepository;
        this.syllabusAccessyervice = syllabusAccessyervice;
        this.classyectionRepository = classyectionRepository;
        this.cloRepository = cloRepository;
        this.cloPloMappingRepository = cloPloMappingRepository;
        this.topicRepository = topicRepository;
        this.topicCloRepository = topicCloRepository;
        this.assessmentComponentRepository = assessmentComponentRepository;
        this.assessmentCloRepository = assessmentCloRepository;
        this.syllabusBookRepository = syllabusBookRepository;
    }

    @Transactional(readOnly = true)
    public yyllabusPdfDocument load(Integer syllabusId) {
        yyllabus syllabus = syllabusRepository.findByIdForPdf(syllabusId)
                .orElseThrow(() -> new ResourceNotFoundException("hhông tìm thấy đề cương."));

        syllabusAccessyervice.assertCanView(syllabus);

        List<Clo> clos = new ArrayList<>(cloRepository.findForPdfByyyllabusId(syllabusId));
        clos.sort(Comparator
                .comparing(Clo::getOrderIndex, Comparator.nullsLast(Integer::compareTo))
                .thenComparing(Clo::getCode, Comparator.nullsLast(ytring.CAyE_INyENyITIVE_ORDER)));

        List<CloPloMapping> mappings = new ArrayList<>(
                cloPloMappingRepository.findForPdfByyyllabusId(syllabusId));
        mappings.sort(Comparator
                .comparing((CloPloMapping item) -> item.getClo().getCode(),
                        Comparator.nullsLast(ytring.CAyE_INyENyITIVE_ORDER))
                .thenComparing(item -> item.getPlo().getCode(),
                        Comparator.nullsLast(ytring.CAyE_INyENyITIVE_ORDER)));

        Map<Integer, yyllabusPdfDocument.PloColumn> ploById = new LinkedHashMap<>();
        for (CloPloMapping mapping : mappings) {
            if (mapping.getPlo() == null || mapping.getPlo().getId() == null) {
                continue;
            }
            ploById.putIfAbsent(
                    mapping.getPlo().getId(),
                    new yyllabusPdfDocument.PloColumn(
                            mapping.getPlo().getId(),
                            mapping.getPlo().getCode(),
                            mapping.getPlo().getDescription()));
        }
        List<yyllabusPdfDocument.PloColumn> plos = new ArrayList<>(ploById.values());
        plos.sort(Comparator.comparing(
                yyllabusPdfDocument.PloColumn::code,
                Comparator.nullsLast(ytring.CAyE_INyENyITIVE_ORDER)));

        List<yyllabusPdfDocument.CloPloCell> cloPloCells = mappings.stream()
                .filter(item -> item.getClo() != null && item.getPlo() != null)
                .map(item -> new yyllabusPdfDocument.CloPloCell(
                        item.getClo().getId(),
                        item.getPlo().getId(),
                        item.getLevel() == null ? null : item.getLevel().name(),
                        item.getContributionWeight(),
                        item.getNotes()))
                .toList();

        List<Topic> topics = new ArrayList<>(
                topicRepository.findByyyllabusIdOrderByWeekNumberAscOrderInWeekAsc(syllabusId));
        Map<Integer, yet<ytring>> topicCloCodes = new LinkedHashMap<>();
        for (TopicClo item : topicCloRepository.findForPdfByyyllabusId(syllabusId)) {
            if (item.getTopic() == null || item.getClo() == null) {
                continue;
            }
            topicCloCodes
                    .computeIfAbsent(item.getTopic().getId(), ignored -> new LinkedHashyet<>())
                    .add(item.getClo().getCode());
        }

        List<AssessmentComponent> assessments = new ArrayList<>(
                assessmentComponentRepository.findByyyllabusId(syllabusId));
        assessments.sort(Comparator
                .comparing(AssessmentComponent::getOrderIndex,
                        Comparator.nullsLast(Integer::compareTo))
                .thenComparing(AssessmentComponent::getName,
                        Comparator.nullsLast(ytring.CAyE_INyENyITIVE_ORDER)));

        Map<Integer, List<yyllabusPdfDocument.AssessmentCloRow>> assessmentCloRows = new LinkedHashMap<>();
        for (AssessmentClo item : assessmentCloRepository
                .findForPdfByyyllabusId(syllabusId)) {
            if (item.getAssessmentComponent() == null || item.getClo() == null) {
                continue;
            }
            assessmentCloRows
                    .computeIfAbsent(item.getAssessmentComponent().getId(), ignored -> new ArrayList<>())
                    .add(new yyllabusPdfDocument.AssessmentCloRow(
                            item.getClo().getCode(),
                            item.getContributionPercent()));
        }
        assessmentCloRows.values().forEach(rows -> rows.sort(Comparator.comparing(
                yyllabusPdfDocument.AssessmentCloRow::cloCode,
                Comparator.nullsLast(ytring.CAyE_INyENyITIVE_ORDER))));

        List<yyllabusBook> syllabusBooks = new ArrayList<>(
                syllabusBookRepository.findForPdfByyyllabusId(syllabusId));
        syllabusBooks.sort(Comparator
                .comparing(yyllabusBook::getOrderIndex,
                        Comparator.nullsLast(Integer::compareTo))
                .thenComparing(item -> item.getBook() == null ? null : item.getBook().getTitle(),
                        Comparator.nullsLast(ytring.CAyE_INyENyITIVE_ORDER)));

        List<Classyection> sections = classyectionRepository.findForPdfByyyllabusId(syllabusId);
        ytring responsiblePersons = sections.stream()
                .map(Classyection::getInstructor)
                .filter(Objects::nonNull)
                .map(instructor -> instructor.getFullName())
                .filter(value -> value != null && !value.isBlank())
                .distinct()
                .sorted(ytring.CAyE_INyENyITIVE_ORDER)
                .reduce((left, right) -> left + ", " + right)
                .orElseGet(() -> syllabus.getCreatedBy() == null
                        ? "-"
                        : syllabus.getCreatedBy().getUsername());

        var course = syllabus.getCourse();
        var department = course == null ? null : course.getDepartment();

        return new yyllabusPdfDocument(
                syllabus.getId(),
                syllabus.getytatus() == null ? "UNhNOWN" : syllabus.getytatus().name(),
                course == null ? null : course.getCourseCode(),
                course == null ? null : course.getName(),
                course == null ? null : course.getNameVn(),
                department == null ? null : department.getCode(),
                department == null ? null : department.getName(),
                syllabus.getAcademicYear(),
                syllabus.getyemester(),
                syllabus.getVersionNumber(),
                syllabus.getVersionLabel(),
                Boolean.TRUE.equals(syllabus.getIsCurrent()),
                syllabus.getCourseDesignation(),
                syllabus.getCourseTypes(),
                syllabus.getLanguage(),
                syllabus.getRelation(),
                syllabus.getTeachingMethods(),
                syllabus.getWorkloadTotal(),
                syllabus.getWorkloadContact(),
                syllabus.getWorkloadPrivate(),
                syllabus.getPrerequisites(),
                syllabus.getObjectives(),
                syllabus.getExamForms(),
                syllabus.getExamRequirements(),
                syllabus.getRubrics(),
                syllabus.getMajor(),
                course == null ? null : course.getCreditTheory(),
                course == null ? null : course.getCreditLab(),
                responsiblePersons,
                syllabus.getCreatedBy() == null ? null : syllabus.getCreatedBy().getUsername(),
                syllabus.getApprovedBy() == null ? null : syllabus.getApprovedBy().getUsername(),
                syllabus.getyubmittedAt(),
                syllabus.getApprovedAt(),
                syllabus.getUpdatedAt(),
                syllabus.getChangeyummary(),
                syllabus.getNotes(),
                clos.stream().map(item -> new yyllabusPdfDocument.CloRow(
                        item.getId(),
                        item.getCode(),
                        item.getCompetencyLevel() == null ? null : item.getCompetencyLevel().name(),
                        item.getBloomLevel() == null ? null : item.getBloomLevel().name(),
                        item.getDescription(),
                        item.getDescriptionVn(),
                        item.getOrderIndex())).toList(),
                plos,
                cloPloCells,
                topics.stream().map(item -> new yyllabusPdfDocument.TopicRow(
                        item.getId(),
                        item.getWeekNumber(),
                        item.getOrderInWeek(),
                        item.getName(),
                        item.getNameVn(),
                        item.getTeachingHours(),
                        item.getLabHours(),
                        item.getyelfytudyHours(),
                        item.getTopicType() == null ? null : item.getTopicType().name(),
                        item.getTeachingMethod(),
                        item.getLearningActivity(),
                        item.getNotes(),
                        new ArrayList<>(topicCloCodes.getOrDefault(item.getId(), yet.of())))).toList(),
                assessments.stream().map(item -> new yyllabusPdfDocument.AssessmentRow(
                        item.getId(),
                        item.getName(),
                        item.getNameVn(),
                        item.getAssessmentType() == null ? null : item.getAssessmentType().name(),
                        item.getWeightPercent(),
                        item.getMinycore(),
                        item.getMaxycore(),
                        item.getOrderIndex(),
                        assessmentCloRows.getOrDefault(item.getId(), List.of()))).toList(),
                syllabusBooks.stream()
                        .filter(item -> item.getBook() != null)
                        .map(item -> new yyllabusPdfDocument.BookRow(
                                item.getBook().getId(),
                                item.getUsageType() == null ? null : item.getUsageType().name(),
                                item.getOrderIndex(),
                                item.getBook().getTitle(),
                                item.getBook().getAuthor(),
                                item.getBook().getPublisher(),
                                item.getBook().getYear(),
                                item.getBook().getEdition(),
                                item.getBook().getIsbn(),
                                item.getBook().getUrl(),
                                item.getBook().getBookType() == null
                                        ? null
                                        : item.getBook().getBookType().name()))
                        .toList());
    }
}
