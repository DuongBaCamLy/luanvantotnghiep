package com.scse.curriculum.instructor.service;

import com.scse.curriculum.common.exception.ResourceNotFoundException;
import com.scse.curriculum.instructor.dto.InstructorRequest;
import com.scse.curriculum.instructor.dto.InstructorResponse;
import com.scse.curriculum.instructor.entity.Instructor;
import com.scse.curriculum.instructor.mapper.InstructorMapper;
import com.scse.curriculum.instructor.repository.InstructorRepository;
import com.scse.curriculum.user.entity.UserAccount;
import com.scse.curriculum.user.repository.UserAccountRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

import java.util.List;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
@org.springframework.transaction.annotation.Transactional
public class InstructorServiceImpl implements InstructorService {

    private final InstructorRepository instructorRepository;
    private final InstructorMapper instructorMapper;
    private final UserAccountRepository userAccountRepository;
    private final com.scse.curriculum.classsection.repository.ClassSectionRepository classSectionRepository;
    private final org.springframework.security.crypto.password.PasswordEncoder passwordEncoder;

    private void populateExtraFields(InstructorResponse response, Integer instructorId) {
        java.util.Optional<com.scse.curriculum.user.entity.UserAccount> userOpt = userAccountRepository.findByInstructorId(instructorId);
        if (userOpt.isEmpty()) {
            userOpt = userAccountRepository.findByEmail(response.getEmail());
        }

        if (userOpt.isPresent()) {
            response.setRole(userOpt.get().getRole());
        } else {
            response.setRole(com.scse.curriculum.user.entity.UserRole.INSTRUCTOR);
        }

        Integer count = classSectionRepository.countDistinctCoursesByInstructorId(instructorId);
        response.setCourseCount(count != null ? count : 0);
    }

    @Override
    public InstructorResponse createInstructor(InstructorRequest request) {

        if (instructorRepository.existsByStaffCode(request.getStaffCode())) {
            throw new IllegalArgumentException("Staff code already exists.");
        }

        if (instructorRepository.existsByEmail(request.getEmail())) {
            throw new IllegalArgumentException("Email already exists.");
        }

        Instructor instructor = instructorMapper.toEntity(request);
        instructor = instructorRepository.save(instructor);

        // Auto-provision corresponding user account if it doesn't exist
        java.util.Optional<com.scse.curriculum.user.entity.UserAccount> userOpt = userAccountRepository.findByEmail(request.getEmail());
        com.scse.curriculum.user.entity.UserAccount userAccount;
        com.scse.curriculum.user.entity.UserRole chosenRole = request.getRole() != null ? request.getRole() : com.scse.curriculum.user.entity.UserRole.INSTRUCTOR;

        if (userOpt.isPresent()) {
            userAccount = userOpt.get();
            userAccount.setInstructorId(instructor.getId());
            userAccount.setRole(chosenRole);
            userAccount.setIsActive(true);
            userAccountRepository.save(userAccount);
        } else {
            String username = request.getEmail().split("@")[0];
            int suffix = 1;
            String baseUsername = username;
            while (userAccountRepository.findByUsername(username).isPresent()) {
                username = baseUsername + suffix;
                suffix++;
            }

            userAccount = com.scse.curriculum.user.entity.UserAccount.builder()
                    .username(username)
                    .email(request.getEmail())
                    .passwordHash(passwordEncoder.encode("admin123"))
                    .role(chosenRole)
                    .instructorId(instructor.getId())
                    .isActive(true)
                    .createdAt(java.time.LocalDateTime.now())
                    .build();
            userAccountRepository.save(userAccount);
        }

        InstructorResponse response = instructorMapper.toResponse(instructor);
        populateExtraFields(response, instructor.getId());
        return response;
    }

    @Override
    public InstructorResponse updateInstructor(Integer id, InstructorRequest request) {

        Instructor instructor = instructorRepository.findById(id)
                .orElseThrow(() ->
                        new ResourceNotFoundException("Instructor not found with id: " + id));

        instructorRepository.findByStaffCode(request.getStaffCode())
                .ifPresent(item -> {
                    if (!item.getId().equals(id)) {
                        throw new IllegalArgumentException("Staff code already exists.");
                    }
                });

        instructorRepository.findByEmail(request.getEmail())
                .ifPresent(item -> {
                    if (!item.getId().equals(id)) {
                        throw new IllegalArgumentException("Email already exists.");
                    }
                });

        instructorMapper.updateEntity(instructor, request);
        instructor = instructorRepository.save(instructor);

        // Update corresponding user account details (role, email, active status)
        com.scse.curriculum.user.entity.UserRole chosenRole = request.getRole() != null ? request.getRole() : com.scse.curriculum.user.entity.UserRole.INSTRUCTOR;
        java.util.Optional<com.scse.curriculum.user.entity.UserAccount> userOpt = userAccountRepository.findByInstructorId(id);
        if (userOpt.isEmpty()) {
            userOpt = userAccountRepository.findByEmail(request.getEmail());
        }

        if (userOpt.isPresent()) {
            com.scse.curriculum.user.entity.UserAccount userAccount = userOpt.get();
            userAccount.setInstructorId(id);
            userAccount.setEmail(request.getEmail());
            userAccount.setRole(chosenRole);
            if (request.getIsActive() != null) {
                userAccount.setIsActive(request.getIsActive());
            }
            userAccountRepository.save(userAccount);
        } else {
            String username = request.getEmail().split("@")[0];
            int suffix = 1;
            String baseUsername = username;
            while (userAccountRepository.findByUsername(username).isPresent()) {
                username = baseUsername + suffix;
                suffix++;
            }

            com.scse.curriculum.user.entity.UserAccount userAccount = com.scse.curriculum.user.entity.UserAccount.builder()
                    .username(username)
                    .email(request.getEmail())
                    .passwordHash(passwordEncoder.encode("admin123"))
                    .role(chosenRole)
                    .instructorId(id)
                    .isActive(request.getIsActive() != null ? request.getIsActive() : true)
                    .createdAt(java.time.LocalDateTime.now())
                    .build();
            userAccountRepository.save(userAccount);
        }

        InstructorResponse response = instructorMapper.toResponse(instructor);
        populateExtraFields(response, id);
        return response;
    }

    @Override
    public List<InstructorResponse> getAllInstructors() {
        return instructorRepository.findAll()
                .stream()
                .map(instructor -> {
                    InstructorResponse response = instructorMapper.toResponse(instructor);
                    populateExtraFields(response, instructor.getId());
                    return response;
                })
                .collect(Collectors.toList());
    }

    @Override
    public void deleteInstructor(Integer id) {
        Instructor instructor = instructorRepository.findById(id)
                .orElseThrow(() ->
                        new ResourceNotFoundException("Instructor not found with id: " + id));

        // Unlink associated user account if exists
        userAccountRepository.findByInstructorId(id).ifPresent(user -> {
            user.setInstructorId(null);
            userAccountRepository.save(user);
        });

        instructorRepository.delete(instructor);
    }

    @Override
    public InstructorResponse getInstructorById(Integer id) {
        Instructor instructor = instructorRepository.findById(id)
                .orElseThrow(() ->
                        new ResourceNotFoundException("Instructor not found with id: " + id));

        InstructorResponse response = instructorMapper.toResponse(instructor);
        populateExtraFields(response, id);
        return response;
    }

    @Override
    public InstructorResponse getInstructorByUserId(Integer userId) {
        UserAccount userAccount = userAccountRepository.findById(userId)
                .orElseThrow(() ->
                        new ResourceNotFoundException("User not found with id: " + userId));

        Integer instructorId = userAccount.getInstructorId();
        if (instructorId == null) {
            throw new ResourceNotFoundException("User is not linked to an instructor");
        }

        Instructor instructor = instructorRepository.findById(instructorId)
                .orElseThrow(() ->
                        new ResourceNotFoundException("Instructor not found with id: " + instructorId));

        InstructorResponse response = instructorMapper.toResponse(instructor);
        populateExtraFields(response, instructorId);
        return response;
    }
}
